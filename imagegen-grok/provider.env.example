# imagegen CLI provider config — copy to a `provider.env` OUTSIDE this skill
# tree (never inside it) and fill in.
#
# Where the real file goes — one config per agent environment:
#   Windows: %APPDATA%\imagegen\<host>\provider.env
#   other:   $XDG_CONFIG_HOME/imagegen/<host>/provider.env
# <host> is workbuddy / claude / opencode / ... inferred from where this skill
# copy is installed (e.g. <host>/.claude/skills/imagegen -> claude). A bare
# source checkout uses the shared directory (%APPDATA%\imagegen or
# ~/.config/imagegen) directly. `IMAGEGEN_CONFIG_DIR` overrides all of it.
#
# Loaded by scripts/image_gen.py (real environment variables take precedence).
# The skill package itself must never carry credentials.

# API key for the provider.
OPENAI_API_KEY=sk-your-key-here

# Base URL. For OpenAI-compatible providers, include the version path, e.g. https://your-host/v1
OPENAI_BASE_URL=https://freeapi.dgbmc.top/v1

# Default model used when --model is not passed.
IMAGEGEN_MODEL=grok-imagine-image-quality
